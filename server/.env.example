# Copy this to .env and fill in your values
# Never commit .env to version control

# Server
PORT=3001
NODE_ENV=production

# PostgreSQL — create a database and a role that owns it first
DATABASE_URL=postgresql://aurelia:yourpassword@localhost:5432/aurelia_hms

# JWT — required in production, at least 32 characters, never the placeholder.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_string
JWT_EXPIRES_IN=8h

# CORS — the origin(s) the browser is served from. Comma-separated for more
# than one. A wildcard is refused in production.
CORS_ORIGIN=https://hms.example.com

# Set to the number of reverse proxies in front of the app (usually 1) so the
# rate limiter sees the real client address.
# TRUST_PROXY=1

# Serve the SPA from this process. Set to false when a CDN or web server hosts
# index.html and assets/ instead.
SERVE_STATIC=true
# STATIC_MAX_AGE=1h

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# The seeded dataset is fictional and is refused when NODE_ENV=production.
# Only a demonstration deployment should set this to true.
# ALLOW_DEMO_SEED=false

# Request body ceiling (brand images travel as base64 inside JSON)
# JSON_BODY_LIMIT=8mb
